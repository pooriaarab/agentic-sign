{
  "name": "agentic-sign",
  "version": "0.1.1",
  "description": "Preview electronic signature requests with a TypeScript SDK, CLI, and MCP server, with experimental Dropbox Sign and BoldSign HTTP routes.",
  "keywords": [
    "dropbox-sign",
    "hellosign",
    "boldsign",
    "electronic-signature",
    "esignature",
    "document-signing",
    "signature-request",
    "typescript",
    "sdk",
    "cli",
    "mcp",
    "dry-run"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-sign.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-sign",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-sign": "./dist/cli.js",
    "agentic-sign-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-core": "^0.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
